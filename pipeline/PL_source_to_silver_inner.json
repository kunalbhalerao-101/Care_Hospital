{
	"name": "PL_source_to_silver_inner",
	"properties": {
		"activities": [
			{
				"name": "Lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "Select *\nfrom ctrl.table_config\nwhere @{pipeline().parameters.table_id} =1;",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZ_SQL_Source",
						"type": "DatasetReference",
						"parameters": {
							"Schema": "ctrl",
							"Tablename": "table_config"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Start Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Start Time",
					"value": {
						"value": "@convertFromUtc(utcNow(), 'India Standard Time', 'yyyy-MM-dd | HH:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Source to Sink Ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Start Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "Select *\nfrom @{activity('Lookup').output.firstRow.source_schema_name}.@{activity('Lookup').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSql_source",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@activity('Lookup').output.firstRow.source_schema_name",
								"type": "Expression"
							},
							"tablename": {
								"value": "@activity('Lookup').output.firstRow.source_table_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Sink",
						"type": "DatasetReference",
						"parameters": {
							"Container": "sink",
							"Folder": {
								"value": "@concat(\n    activity('Lookup').output.firstRow.source_system,\n    '/',\n    activity('Lookup').output.firstRow.source_table_name,\n    '/',\n    variables('Start Time')\n)",
								"type": "Expression"
							},
							"Filename": {
								"value": "@concat(\n    activity('Lookup').output.firstRow.source_table_name,' | ',\n    variables('Start Time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Sink to Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Source to Sink Ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/kbhalerao1966@gmail.com/Care_Hospital---az-Databricks-repo/Sink to Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Lookup').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Lookup').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Start Time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze to Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Sink to Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/kbhalerao1966@gmail.com/Care_Hospital---az-Databricks-repo/Bronze to Silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Lookup').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Start Time')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Failed",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_SQL_DB",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log\nSET STATUS  = 'SUCCESS' , end_time = SYSDATETIME(),records_written = @{activity('Bronze to Silver').output.runOutput}\nWHERE @{pipeline().parameters.adf_run_id} = 'A2' AND @{pipeline().parameters.table_id} = 1",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "A1"
			}
		},
		"variables": {
			"Start Time": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Care Hospital"
		},
		"annotations": []
	}
}