{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "az-datafactory-hospital"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1024-082312-sqbfycuz"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azdatalake99.dfs.core.windows.net/"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://HospitalxPassword.vault.azure.net/"
		},
		"LS_PostgreSql_Source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-spring-base-a173i08o-pooler.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql_Source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_Source_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_SQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-hospital.database.windows.net"
		},
		"LS_SQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-1450877"
		},
		"LS_SQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "kunal"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "az-datafactory-hospital_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_PostgreSql_Source_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_Source_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_Source_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_Source_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_Source_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_Source_properties_typeProperties_username')]"
					},
					"LS_SQL_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_server')]"
					},
					"LS_SQL_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_database')]"
					},
					"LS_SQL_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}